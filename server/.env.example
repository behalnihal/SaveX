PORT=8000
# Comma-separated frontend origins. Omit to allow any origin.
CLIENT_ORIGIN=http://localhost:3000
# Optional absolute path to yt-dlp, if it is not on PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# Optional server-side YouTube session. Mount the file as a read-only secret.
# YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# Optional proxy you control, used only for YouTube requests.
# YOUTUBE_PROXY_URL=http://username:password@proxy.example:8080
